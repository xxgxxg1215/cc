/* 全局样式 — 农业绿色主题 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC',
               'Microsoft YaHei', 'Helvetica Neue', sans-serif;
  background-color: #F0FDF4;
  color: #1F2937;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* 容器 */
.container {
  padding: 32rpx;
  min-height: 100vh;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #059669, #10B981);
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  line-height: 1.5;
}

.btn-primary::after {
  border: none;
}

/* 次要按钮 */
.btn-secondary {
  background: #FFFFFF;
  color: #059669;
  border: 2rpx solid #059669;
  border-radius: 16rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  line-height: 1.5;
}

.btn-secondary::after {
  border: none;
}

/* 标签 */
.tag-healthy {
  display: inline-block;
  background: #ECFDF5;
  color: #059669;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
}

.tag-disease {
  display: inline-block;
  background: #FEF2F2;
  color: #DC2626;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #E5E7EB;
  margin: 24rpx 0;
}
