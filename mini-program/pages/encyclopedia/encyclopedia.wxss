.container { padding: 32rpx 32rpx 120rpx; }
.page-title { font-size: 36rpx; font-weight: 700; color: #064E3B; margin-bottom: 20rpx; }
.search-input { background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; font-size: 28rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.crop-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.crop-tab { display: inline-block; padding: 12rpx 28rpx; border-radius: 32rpx; font-size: 24rpx; background: #fff; color: #6B7280; margin-right: 12rpx; }
.crop-tab.active { background: #059669; color: #fff; }
.empty { text-align: center; padding: 80rpx 0; color: #9CA3AF; font-size: 28rpx; }
.enc-card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.enc-crop-tag { display: inline-block; background: #ECFDF5; color: #059669; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 6rpx; margin-bottom: 12rpx; font-weight: 600; }
.enc-name { font-size: 30rpx; font-weight: 600; color: #1F2937; margin-bottom: 8rpx; }
.enc-desc { font-size: 24rpx; color: #6B7280; line-height: 1.6; }
