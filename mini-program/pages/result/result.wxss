/* pages/result/result.wxss */

.container {
  padding: 24rpx 32rpx 180rpx;
}

/* ---- 图片预览 ---- */
.image-section {
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.preview-image {
  width: 100%;
  height: 400rpx;
  display: block;
}

/* ---- 识别结果卡片 ---- */
.result-card {
  padding: 36rpx 32rpx;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.result-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  flex: 1;
  margin-right: 16rpx;
}

.confidence-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.confidence-label {
  font-size: 26rpx;
  color: #6B7280;
}

.confidence-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #059669;
}

.confidence-bar {
  height: 12rpx;
  background: #F3F4F6;
  border-radius: 6rpx;
  overflow: hidden;
}

.confidence-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 600ms ease;
}

.fill-healthy {
  background: linear-gradient(90deg, #10B981, #059669);
}

.fill-disease {
  background: linear-gradient(90deg, #F87171, #DC2626);
}

/* ---- 通用 section ---- */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 24rpx;
}

/* ---- Top-5 ---- */
.top5-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.top5-item {
  display: flex;
  align-items: center;
}

.top5-rank {
  width: 40rpx;
  height: 40rpx;
  background: #F3F4F6;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top5-info {
  flex: 1;
  margin: 0 20rpx;
}

.top5-name {
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 8rpx;
}

.top5-bar-bg {
  height: 8rpx;
  background: #F3F4F6;
  border-radius: 4rpx;
  overflow: hidden;
}

.top5-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #10B981, #059669);
  border-radius: 4rpx;
}

.top5-conf {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
  width: 100rpx;
  text-align: right;
  flex-shrink: 0;
}

/* ---- 防治建议 ---- */
.treatment-card {
  padding: 32rpx;
}

.treatment-block {
  margin-bottom: 32rpx;
}

.treatment-block:last-child {
  margin-bottom: 0;
}

.treatment-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.label-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #059669;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.dot-orange {
  background: #F59E0B;
}

.dot-red {
  background: #EF4444;
}

.dot-green {
  background: #10B981;
}

.dot-blue {
  background: #3B82F6;
}

.treatment-content {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.8;
  padding-left: 24rpx;
}

.treatment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-left: 24rpx;
}

.treatment-item {
  display: flex;
  align-items: flex-start;
}

.item-index {
  width: 36rpx;
  height: 36rpx;
  background: #ECFDF5;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #059669;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 12rpx;
  margin-top: 2rpx;
}

.item-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.7;
  flex: 1;
}

/* ---- 底部操作 ---- */
.action-bottom {
  margin-top: 12rpx;
  padding-bottom: 40rpx;
}

/* ---- Loading ---- */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-text {
  font-size: 30rpx;
  color: #9CA3AF;
}
