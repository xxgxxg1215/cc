.container { padding: 0 32rpx 80rpx; }
.profile-header { text-align: center; padding: 60rpx 0 40rpx; }
.avatar-large { width: 140rpx; height: 140rpx; border-radius: 50%; background: linear-gradient(135deg, #059669, #10B981); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 52rpx; font-weight: 700; margin: 0 auto 20rpx; }
.user-name { font-size: 36rpx; font-weight: 700; color: #064E3B; margin-bottom: 8rpx; }
.user-role { font-size: 24rpx; color: #059669; }
.login-hint { font-size: 26rpx; color: #6B7280; margin-bottom: 20rpx; }
.btn-login { background: linear-gradient(135deg, #059669, #10B981) !important; color: #fff !important; border-radius: 32rpx !important; font-size: 28rpx !important; padding: 16rpx 48rpx !important; border: none !important; }
.menu-card { background: #fff; border-radius: 20rpx; overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); margin-bottom: 24rpx; }
.menu-item { display: flex; align-items: center; padding: 28rpx 24rpx; border-bottom: 1rpx solid #F3F4F6; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 16rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: #374151; }
.menu-badge { background: #059669; color: #fff; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; margin-right: 8rpx; }
.menu-arrow { color: #D1D5DB; font-size: 36rpx; }
.logout-area { padding: 24rpx 0; }
.btn-logout { background: #fff !important; color: #DC2626 !important; border: 2rpx solid #DC2626 !important; border-radius: 16rpx !important; font-size: 28rpx !important; }
.version { text-align: center; padding: 40rpx 0; font-size: 22rpx; color: #9CA3AF; }
