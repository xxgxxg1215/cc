.container { padding: 32rpx 32rpx 140rpx; }
.post-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: linear-gradient(135deg, #059669, #10B981); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; flex-shrink: 0; }
.header-info { margin-left: 16rpx; }
.nickname { font-size: 28rpx; font-weight: 600; color: #1F2937; }
.post-role { font-size: 20rpx; margin-left: 8rpx; }
.time { display: block; font-size: 22rpx; color: #9CA3AF; margin-top: 4rpx; }
.post-title { font-size: 34rpx; font-weight: 700; color: #064E3B; margin-bottom: 16rpx; }
.post-body { font-size: 28rpx; color: #374151; line-height: 1.8; margin-bottom: 20rpx; }
.full-img { width: 100%; border-radius: 16rpx; margin-bottom: 12rpx; }
.like-bar { padding: 16rpx 0; font-size: 28rpx; color: #059669; }
.divider { height: 1rpx; background: #E5E7EB; margin: 16rpx 0; }
.section-title { font-size: 28rpx; font-weight: 600; color: #374151; margin-bottom: 16rpx; }
.empty-comment { font-size: 26rpx; color: #9CA3AF; padding: 24rpx 0; }
.comment-item { padding: 16rpx 0; border-bottom: 1rpx solid #F3F4F6; }
.comment-user { display: flex; align-items: center; margin-bottom: 8rpx; }
.avatar-sm { width: 48rpx; height: 48rpx; border-radius: 50%; background: #ECFDF5; color: #059669; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 600; }
.comment-name { font-size: 24rpx; font-weight: 600; color: #374151; margin-left: 12rpx; }
.comment-role { font-size: 18rpx; margin-left: 4rpx; }
.comment-time { font-size: 20rpx; color: #9CA3AF; margin-left: auto; }
.comment-text { font-size: 26rpx; color: #4B5563; line-height: 1.6; padding-left: 60rpx; }
.comment-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; padding: 16rpx 24rpx; background: #fff; border-top: 1rpx solid #E5E7EB; gap: 12rpx; }
.comment-input { flex: 1; background: #F3F4F6; border-radius: 32rpx; padding: 16rpx 24rpx; font-size: 26rpx; }
.send-btn { background: #059669; color: #fff; padding: 16rpx 32rpx; border-radius: 32rpx; font-size: 26rpx; font-weight: 600; flex-shrink: 0; }
