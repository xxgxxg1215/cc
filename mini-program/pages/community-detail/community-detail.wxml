<view class="container" wx:if="{{post}}">
  <view class="post-header">
    <view class="avatar">{{post.user.nickname[0] || '?'}}</view>
    <view class="header-info">
      <text class="nickname">{{post.user.nickname}}</text>
      <text class="post-role" wx:if="{{post.user.role === 'expert'}}">🌟专家</text>
      <text class="time">{{post.created_at}}</text>
    </view>
  </view>
  <view class="post-title">{{post.title}}</view>
  <view class="post-body">{{post.content}}</view>
  <view class="post-images" wx:if="{{post.image_urls.length > 0}}">
    <image wx:for="{{post.image_urls}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="widthFix" class="full-img"></image>
  </view>
  <view class="like-bar" bindtap="onToggleLike">
    <text>👍 {{post.like_count}} 赞</text>
  </view>
  <view class="divider"></view>
  <view class="section-title">评论 ({{post.comments.length}})</view>
  <view wx:if="{{post.comments.length === 0}}" class="empty-comment">暂无评论</view>
  <view class="comment-item" wx:for="{{post.comments}}" wx:key="id">
    <view class="comment-user">
      <view class="avatar-sm">{{item.user.nickname[0]}}</view>
      <text class="comment-name">{{item.user.nickname}}</text>
      <text class="comment-role" wx:if="{{item.user.role === 'expert'}}">🌟</text>
      <text class="comment-time">{{item.created_at}}</text>
    </view>
    <view class="comment-text">{{item.content}}</view>
  </view>
  <view class="comment-bar">
    <input class="comment-input" placeholder="说点什么..." bindinput="onCommentInput" value="{{commentText}}" />
    <view class="send-btn" bindtap="onSubmitComment">发送</view>
  </view>
</view>
