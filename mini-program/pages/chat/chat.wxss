page {
  background-color: #f5f5f5;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #fff;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  background-color: #f5f5f5;
}

.message-item {
  display: flex;
  margin-bottom: 16px;
  align-items: flex-end;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-avatar {
  margin: 0 8px;
  font-size: 32px;
}

.avatar {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.avatar.bot {
  background-color: #e8f5e9;
}

.avatar.user {
  background-color: #e3f2fd;
}

.message-bubble {
  max-width: 70%;
  padding: 12px 16px;
  border-radius: 12px;
  word-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
  font-size: 14px;
}

.message-bubble.assistant {
  background-color: #fff;
  color: #333;
  border: 1px solid #e0e0e0;
}

.message-bubble.user {
  background-color: #1890ff;
  color: #fff;
}

.message-text {
  display: block;
  white-space: pre-wrap;
}

.loading {
  display: flex;
  align-items: center;
  gap: 4px;
  height: 16px;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #999;
  animation: bounce 1.4s infinite;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% {
    opacity: 0.3;
    transform: scale(0.8);
  }
  40% {
    opacity: 1;
    transform: scale(1);
  }
}

.input-area {
  display: flex;
  padding: 12px;
  background-color: #fff;
  border-top: 1px solid #e0e0e0;
  gap: 8px;
}

.input-box {
  flex: 1;
  height: 40px;
  padding: 0 12px;
  background-color: #f5f5f5;
  border: 1px solid #e0e0e0;
  border-radius: 20px;
  font-size: 14px;
}

.placeholder {
  color: #999;
}

.send-btn {
  width: 60px;
  height: 40px;
  background-color: #1890ff;
  color: #fff;
  border: none;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn[disabled] {
  opacity: 0.5;
}
