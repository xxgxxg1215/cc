.container { padding: 32rpx 32rpx 120rpx; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.page-title { font-size: 36rpx; font-weight: 700; color: #064E3B; }
.post-btn { background: #059669; color: #fff; font-size: 26rpx; padding: 12rpx 28rpx; border-radius: 32rpx; font-weight: 600; }
.empty { text-align: center; padding: 80rpx 0; color: #9CA3AF; font-size: 28rpx; }
.post-card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.post-user { display: flex; align-items: center; margin-bottom: 16rpx; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: linear-gradient(135deg, #059669, #10B981); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; flex-shrink: 0; }
.post-user-info { flex: 1; margin-left: 16rpx; }
.post-nickname { font-size: 26rpx; font-weight: 600; color: #1F2937; }
.post-role { font-size: 20rpx; margin-left: 8rpx; }
.post-time { font-size: 22rpx; color: #9CA3AF; }
.post-title { font-size: 30rpx; font-weight: 600; color: #1F2937; margin-bottom: 8rpx; }
.post-content { font-size: 26rpx; color: #4B5563; line-height: 1.6; margin-bottom: 12rpx; }
.post-images { display: flex; gap: 8rpx; margin-bottom: 12rpx; }
.post-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; }
.post-actions { display: flex; gap: 32rpx; }
.post-action { font-size: 24rpx; color: #6B7280; }
.loading-tip { text-align: center; padding: 24rpx; font-size: 24rpx; color: #9CA3AF; }
