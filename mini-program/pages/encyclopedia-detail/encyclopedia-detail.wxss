.container { padding: 32rpx; }
.detail-header { margin-bottom: 24rpx; }
.detail-crop { display: inline-block; background: #ECFDF5; color: #059669; font-size: 24rpx; padding: 6rpx 20rpx; border-radius: 8rpx; font-weight: 600; margin-bottom: 12rpx; }
.detail-name { font-size: 40rpx; font-weight: 700; color: #064E3B; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.section-title { font-size: 28rpx; font-weight: 600; color: #374151; margin-bottom: 16rpx; }
.section-text { font-size: 26rpx; color: #4B5563; line-height: 1.8; }
.list-item { font-size: 26rpx; color: #4B5563; line-height: 2; padding-left: 8rpx; }
