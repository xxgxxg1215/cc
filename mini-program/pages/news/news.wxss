.container { padding: 32rpx 32rpx 120rpx; }
.page-title { font-size: 36rpx; font-weight: 700; color: #064E3B; margin-bottom: 24rpx; }
.empty { text-align: center; padding: 80rpx 0; color: #9CA3AF; font-size: 28rpx; }
.news-card { display: flex; background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.news-cover { width: 180rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; margin-right: 20rpx; }
.news-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.news-title { font-size: 28rpx; font-weight: 600; color: #1F2937; line-height: 1.4; }
.news-meta { display: flex; justify-content: space-between; }
.news-author { font-size: 22rpx; color: #059669; }
.news-date { font-size: 22rpx; color: #9CA3AF; }
.loading-tip { text-align: center; padding: 24rpx; font-size: 24rpx; color: #9CA3AF; }
