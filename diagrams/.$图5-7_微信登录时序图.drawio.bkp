          <mxGeometry x="900" y="30" width="90" height="580" as="geometry"/>
        </mxCell>
        <!-- Messages -->
        <mxCell id="m1" value="1. 点击登录按钮" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1">
