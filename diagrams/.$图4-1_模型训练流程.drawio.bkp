<mxfile host="app.diagrams.net" modified="2026-03-06">
  <diagram id="train-flow" name="模型训练流程">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="加载 ImageNet 预训练模型&#xa;(ResNet50 / EfficientNet-B0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="30" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="修改全连接层&#xa;(输出 38 类)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="405" y="115" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="2" target="3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Phase 1 -->
        <mxCell id="p1" value="第一阶段：冻结 Backbone（Epoch 1-5）" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="195" width="370" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p1a" value="仅训练分类头 | 学习率: 1e-3 | Adam 优化器" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p1">
          <mxGeometry x="15" y="35" width="340" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="3" target="p1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Phase 2 -->
        <mxCell id="p2" value="第二阶段：解冻全部参数（Epoch 6-30）" style="swimlane;startSize=25;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="320" width="370" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2a" value="差分学习率: Backbone 1e-4 / 分类头 1e-3&#xa;CosineAnnealing 学习率调度" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2">
          <mxGeometry x="15" y="35" width="340" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p1" target="p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Training Loop -->
        <mxCell id="4" value="前向传播 → 计算损失&#xa;(CrossEntropy / Focal Loss)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="445" width="210" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p2" target="4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="5" value="反向传播 → 参数更新" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="520" width="210" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="4" target="5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="6" value="验证集评估" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="590" width="150" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="5" target="6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Decision: Best? -->
        <mxCell id="7" value="准确率&#xa;提升?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="665" width="110" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="6" target="7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Save best -->
        <mxCell id="8" value="保存最优模型&#xa;(best_model.pt)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="680" width="140" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="是" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="7" target="8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Decision: Early Stop -->
        <mxCell id="9" value="连续7轮&#xa;未提升?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="665" width="110" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="否" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="7" target="9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Continue -->
        <mxCell id="e10" value="否 → 继续训练" style="edgeStyle=orthogonalEdgeStyle;curved=1;" edge="1" source="9" target="4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="705"/>
              <mxPoint x="160" y="467"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Stop -->
        <mxCell id="10" value="Early Stopping&#xa;训练结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="225" y="790" width="120" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="是" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="9" target="10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Output -->
        <mxCell id="11" value="输出：最优模型权重 + 训练曲线 + 分类报告 + 混淆矩阵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="870" width="390" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="10" target="11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="8" target="11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>